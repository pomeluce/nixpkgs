+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+
+const { platform, win, getSettings } = vi.hoisted(() => ({
+  platform: { windows: false, web: false },
+  win: {
+    isMaximized: vi.fn(async () => false),
+    onResized: vi.fn(async () => () => {}),
+    close: vi.fn(async () => {}),
+    minimize: vi.fn(async () => {}),
+    toggleMaximize: vi.fn(async () => {}),
+  },
+  getSettings: vi.fn(async () => ({ titlebar: "mac" })),
+}));
+vi.mock("@/lib/platform", () => ({
+  get IS_WINDOWS() { return platform.windows; },
+  get isWeb() { return platform.web; },
+}));
+vi.mock("@/lib/ipc", () => ({ ipc: { getAppSettings: getSettings } }));
+vi.mock("@tauri-apps/api/window", () => ({ getCurrentWindow: () => win }));
+
+import { WindowControls } from "@/components/application/window-controls";
+import { needsWindowControls, useTitlebarStyle } from "./titlebar";
+
+let container: HTMLDivElement;
+let root: Root;
+function Frame() {
+  const style = useTitlebarStyle();
+  return <div data-style={style}>{needsWindowControls(style) && <WindowControls />}</div>;
+}
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.stubEnv("VITE_FRAMELESS_WINDOW", "1");
+  platform.windows = false;
+  platform.web = false;
+  globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  root = createRoot(container);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  container.remove();
+  vi.unstubAllEnvs();
+});
+
+it("frameless desktop renders working window controls on its first render", async () => {
+  await act(async () => root.render(<Frame />));
+  expect(container.firstElementChild?.getAttribute("data-style")).toBe("mac");
+  expect(getSettings).not.toHaveBeenCalled();
+  expect(container.querySelectorAll("button")).toHaveLength(3);
+  for (const label of ["关闭", "最小化", "最大化"]) {
+    const button = container.querySelector<HTMLButtonElement>(`button[aria-label="${label}"]`);
+    expect(button).not.toBeNull();
+    await act(async () => button!.click());
+  }
+  expect(win.close).toHaveBeenCalledOnce();
+  expect(win.minimize).toHaveBeenCalledOnce();
+  expect(win.toggleMaximize).toHaveBeenCalledOnce();
+});
+it("web access never renders native window controls", async () => {
+  platform.web = true;
+  await act(async () => root.render(<Frame />));
+  expect(container.querySelectorAll("button")).toHaveLength(0);
+  expect(getSettings).not.toHaveBeenCalled();
+});
+it("decorated desktop keeps the existing controls policy", () => {
+  vi.stubEnv("VITE_FRAMELESS_WINDOW", "");
+  expect(needsWindowControls("native")).toBe(false);
+  expect(needsWindowControls("mac")).toBe(false);
+  platform.windows = true;
+  expect(needsWindowControls("native")).toBe(false);
+  expect(needsWindowControls("mac")).toBe(true);
+});
