--- /dev/null
+++ b/src/features/update/managed-updates.test.tsx
@@ -0,0 +1,49 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { afterAll, expect, it, vi } from "vitest";
+
+vi.mock("@tauri-apps/api/core", () => ({ invoke: vi.fn() }));
+vi.mock("@tauri-apps/plugin-updater", () => ({ check: vi.fn() }));
+vi.mock("@tauri-apps/plugin-process", () => ({ relaunch: vi.fn() }));
+vi.mock("@/lib/transport", () => ({ isWeb: false }));
+vi.mock("@/lib/platform", () => ({
+  getAppVersion: async () => "1.1.9",
+  openExternal: vi.fn(),
+}));
+
+vi.stubEnv("VITE_DISABLE_UPDATER", "1");
+afterAll(() => vi.unstubAllEnvs());
+const { useUpdateStore } = await import("./store");
+
+it("never checks, downloads or restarts when updates are managed by Nix", async () => {
+  const { invoke } = await import("@tauri-apps/api/core");
+  const { check } = await import("@tauri-apps/plugin-updater");
+  const { relaunch } = await import("@tauri-apps/plugin-process");
+  await useUpdateStore.getState().checkForUpdates();
+  await useUpdateStore.getState().checkForUpdates({ interactive: true });
+  await useUpdateStore.getState().startUpdate();
+  expect(check).not.toHaveBeenCalled();
+  expect(invoke).not.toHaveBeenCalled();
+  expect(relaunch).not.toHaveBeenCalled();
+  expect(useUpdateStore.getState().stage).toBe("idle");
+});
+
+it("explains Nix updates without offering check or install buttons", async () => {
+  await import("@/lib/i18n");
+  const { UpdateSection } = await import("@/features/settings/UpdateSection");
+  const { ReleaseNotesPane } = await import("./ReleaseNotesPane");
+  const { useReleaseNotesTabStore } = await import("./notes-tab");
+  useReleaseNotesTabStore.setState({ open: true, active: true });
+  globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+  const container = document.createElement("div");
+  document.body.appendChild(container);
+  const root = createRoot(container);
+  try {
+    await act(async () => root.render(<><UpdateSection /><ReleaseNotesPane /></>));
+    expect(container.textContent).toContain("Nix");
+    expect(container.querySelectorAll("button")).toHaveLength(0);
+  } finally {
+    await act(async () => root.unmount());
+    container.remove();
+  }
+});
